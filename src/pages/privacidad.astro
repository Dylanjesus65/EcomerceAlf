        <div id="sec9">
          <h2 class="text-2xl font-bold text-gray-900 mb-4 flex items-center gap-3">
            <span class="w-10 h-10 bg-[#F0A520] text-white rounded-full flex items-center justify-center font-bold text-lg flex-shrink-0">9</span>
