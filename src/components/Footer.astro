---
import '@fortawesome/fontawesome-free/css/all.min.css';
import Layout from '../layouts/Layout.astro';
---
<Layout>
  <footer class="bg-[#0D1117] text-white">
    <!-- Franja dorada superior decorativa -->
    <div class="h-1 bg-gradient-to-r from-[#F0A520] via-[#F3A51B] to-[#D08700]"></div>

    <!-- Contenido principal del footer -->
    <div class="max-w-7xl mx-auto px-6 md:px-12 py-12">
      <div class="grid grid-cols-1 md:grid-cols-3 gap-10 items-start">

        <!-- Columna 1: Logo + Descripción -->
        <div class="flex flex-col items-center md:items-start">
          <a href="/" class="mb-4">
            <img src="/logo2.webp" alt="ALF Seguridad y Salud" class="h-12 max-w-[160px] object-contain">
          </a>
          <p class="text-gray-400 text-sm leading-relaxed text-center md:text-left">
            Tu socio estratégico en seguridad y salud ocupacional. Protegemos a tu equipo para que te enfoques en crecer.
          </p>
          <!-- Redes Sociales -->
          <div class="flex space-x-3 mt-5">
            <a href="https://www.instagram.com/alfseguridadysalud/" target="_blank" aria-label="Instagram"
               class="w-10 h-10 rounded-full bg-white/10 flex items-center justify-center text-gray-300 hover:bg-[#F0A520] hover:text-white transition-all duration-300">
              <i class="fab fa-instagram"></i>
            </a>
            <a href="https://www.facebook.com/alfseguridadysalud" target="_blank" aria-label="Facebook"
               class="w-10 h-10 rounded-full bg-white/10 flex items-center justify-center text-gray-300 hover:bg-[#F0A520] hover:text-white transition-all duration-300">
              <i class="fab fa-facebook-f"></i>
            </a>
            <a href="https://www.linkedin.com/in/alf-seguridad-y-salud/" target="_blank" aria-label="LinkedIn"
               class="w-10 h-10 rounded-full bg-white/10 flex items-center justify-center text-gray-300 hover:bg-[#F0A520] hover:text-white transition-all duration-300">
              <i class="fab fa-linkedin-in"></i>
            </a>
          </div>
        </div>

        <!-- Columna 2: Enlaces Rápidos -->
        <div class="flex flex-col items-center md:items-start">
          <h3 class="text-[#F0A520] font-bold text-lg mb-4 relative">
            Enlaces
            <span class="absolute bottom-[-4px] left-0 w-8 h-0.5 bg-[#F0A520] hidden md:block"></span>
          </h3>
          <nav class="flex flex-col space-y-3 text-center md:text-left">
            <a href="/" class="text-gray-400 hover:text-[#F0A520] transition-colors duration-300 text-sm">
              <i class="fas fa-chevron-right text-[#F0A520] text-xs mr-2"></i>Inicio
            </a>
            <a href="/nosotros" class="text-gray-400 hover:text-[#F0A520] transition-colors duration-300 text-sm">
              <i class="fas fa-chevron-right text-[#F0A520] text-xs mr-2"></i>Nosotros
            </a>
            <a href="/servicios" class="text-gray-400 hover:text-[#F0A520] transition-colors duration-300 text-sm">
              <i class="fas fa-chevron-right text-[#F0A520] text-xs mr-2"></i>Servicios
            </a>
            <a href="/contacto" class="text-gray-400 hover:text-[#F0A520] transition-colors duration-300 text-sm">
              <i class="fas fa-chevron-right text-[#F0A520] text-xs mr-2"></i>Contacto
            </a>
            <a href="/privacidad" class="text-gray-400 hover:text-[#F0A520] transition-colors duration-300 text-sm">
              <i class="fas fa-chevron-right text-[#F0A520] text-xs mr-2"></i>Política de Privacidad
            </a>
          </nav>
        </div>

        <!-- Columna 3: Contacto -->
        <div class="flex flex-col items-center md:items-start">
          <h3 class="text-[#F0A520] font-bold text-lg mb-4 relative">
            Contacto
            <span class="absolute bottom-[-4px] left-0 w-8 h-0.5 bg-[#F0A520] hidden md:block"></span>
          </h3>
          <div class="space-y-4">
            <a href="https://wa.me/593992738731?text=Me%20gustar%C3%ADa%20obtener%20m%C3%A1s%20informaci%C3%B3n%20sobre%20sus%20servicios."
               target="_blank"
               class="flex items-center gap-3 text-gray-400 hover:text-[#F0A520] transition-colors duration-300 text-sm group">
              <span class="w-9 h-9 rounded-full bg-white/10 flex items-center justify-center group-hover:bg-[#F0A520] group-hover:text-white transition-all duration-300">
                <i class="fas fa-phone-alt text-xs"></i>
              </span>
              +593 99 273 8731
            </a>
            <a href="mailto:info@alfseguridadysalud.com"
               class="flex items-center gap-3 text-gray-400 hover:text-[#F0A520] transition-colors duration-300 text-sm group">
              <span class="w-9 h-9 rounded-full bg-white/10 flex items-center justify-center group-hover:bg-[#F0A520] group-hover:text-white transition-all duration-300">
                <i class="fas fa-envelope text-xs"></i>
              </span>
              info@alfseguridadysalud.com
            </a>
            <div class="flex items-center gap-3 text-gray-400 text-sm">
              <span class="w-9 h-9 rounded-full bg-white/10 flex items-center justify-center">
                <i class="fas fa-map-marker-alt text-xs"></i>
              </span>
              Quito, Ecuador
            </div>
          </div>
        </div>

      </div>
    </div>

    <!-- Barra inferior de copyright -->
    <div class="border-t border-white/10">
      <div class="max-w-7xl mx-auto px-6 md:px-12 py-4 flex flex-col sm:flex-row justify-between items-center gap-2">
        <p class="text-gray-500 text-xs">© 2026 ALF Seguridad y Salud. Todos los derechos reservados.</p>
        <a href="/privacidad" class="text-gray-500 text-xs hover:text-[#F0A520] transition-colors duration-300">Política de Privacidad</a>
      </div>
    </div>
  </footer>
</Layout>